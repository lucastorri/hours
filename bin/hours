#!/bin/sh
# Launcher, so `hours` is a real command on Node versions that do not strip types by
# default. Node runs the TypeScript directly; there is no build step.
set -e

# Follow symlinks: installed via `npm link`, $0 is a link in the npm bin directory, and
# the project is wherever that link points.
src=$0
while [ -L "$src" ]; do
  dir=$(CDPATH= cd -P -- "$(dirname -- "$src")" && pwd)
  src=$(readlink "$src")
  case $src in
    /*) ;;
    *) src=$dir/$src ;;
  esac
done
here=$(CDPATH= cd -P -- "$(dirname -- "$src")/.." && pwd)

# Type stripping is the default from Node 23.6; before that it needs asking for.
case "$(node --version)" in
  v1[0-9].* | v2[0-2].*) strip="--experimental-strip-types" ;;
  *) strip="" ;;
esac

# shellcheck disable=SC2086
exec node $strip --disable-warning=ExperimentalWarning "$here/src/cli.ts" "$@"
